# Copy this file to .env and fill in your keys.
# .env is loaded automatically by the FastAPI server and `langgraph dev`.


DASHSCOPE_API_KEY=your-dashscope-key-here
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


TAVILY_API_KEY=your-tavily-key-here


AMAP_API_KEY=your-amap-key-here
MAP_TIMEOUT_SECONDS=5

CHROMA_HOST=192.168.19.128
CHROMA_PORT=8000
CHROMA_SSL=false
REDIS_URL=redis://192.168.19.128:6379/0
EMOTION_ACTIVE_BOOK_NAMES=科学脱单指南  如何让你爱的人爱上你,吸引力的秘密
EMOTION_ACTIVE_BOOK_NAME=科学脱单指南  如何让你爱的人爱上你
EMOTION_ROUTER_MAX_BOOKS=2
EMOTION_MEMORY_WINDOW_MESSAGES=20
EMOTION_REPORTS_DIR=data/emotion_reports
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=travel-planner-agent
EMOTION_EMBED_MODEL=
